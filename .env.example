# The only value you need to enter.
PRAMAAN_API_KEY=

# Working local defaults. Secrets are generated by ./start when missing.
NEXT_PUBLIC_WEBAPP_URL=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000/api/auth
REDIS_URL=redis://redis:6379
NEXTAUTH_SECRET=
SCHEDULING_ENCRYPTION_KEY=

# Optional — leave these commented until you set up the feature.
# PRAMAAN_BASE_URL=
# EMAIL_FROM=
# EMAIL_FROM_NAME=
# Paid bookings use digital_products unless the operator chooses another supported category.
# PRAMAAN_TAX_CATEGORY=digital_products
# PRAMAAN_SIGNIN_CONNECTION_REF=
# PRAMAAN_SIGNIN_PRODUCT=
# PRAMAAN_SIGNIN_AUTHORIZATION_URL=
# PRAMAAN_SIGNIN_CLIENT_ID=
# SCHEDULING_BILLING_PLAN_ID=
# SCHEDULING_DOMAIN_REF=
# SCHEDULING_DOMAIN_SUFFIX=
# SCHEDULING_DOMAIN_TARGET=
# SCHEDULING_BOT_CHECK_ENABLED=
# NEXT_PUBLIC_BOT_CHECK_ENABLED=

# Optional: both operator policy URLs are needed to show policy links.
# NEXT_PUBLIC_WEBSITE_TERMS_URL=
# NEXT_PUBLIC_WEBSITE_PRIVACY_POLICY_URL=
