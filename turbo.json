        "NEXT_PUBLIC_WEBSITE_URL",
        "TRACING_AUTH_TOKEN",
        "TRACING_DEBUG",
        "TRACING_MAX_SPANS",
        "TRACING_ORG",
        "TRACING_PROJECT",
        "TRACING_SAMPLE_RATE",
        "TRACING_TRACES_SAMPLE_RATE",
        "TRACING_REPLAYS_SESSION_SAMPLE_RATE",
        "TRACING_REPLAYS_ON_ERROR_SAMPLE_RATE",
        "LEGACY_PAYMENT_TEAM_MONTHLY_PRICE_ID",
        "LEGACY_PAYMENT_TEAM_ANNUAL_PRICE_ID",
        "NEXT_PUBLIC_LEGACY_PAYMENT_CREDITS_PRICE_ID",
        "LEGACY_PAYMENT_TEAM_PRODUCT_ID",
        "ORG_MONTHLY_CREDITS",
        "LEGACY_PAYMENT_ORG_MONTHLY_PRICE_ID",
        "LEGACY_PAYMENT_ORG_ANNUAL_PRICE_ID",
        "LEGACY_PAYMENT_ORG_PRODUCT_ID",
        "LEGACY_PAYMENT_ORG_TRIAL_DAYS",
        "NEXT_PUBLIC_API_V2_URL",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "NEXT_PUBLIC_TRACING_DSN_CLIENT",
        "BUILD_STANDALONE",
        "NEXT_PUBLIC_API_HITPAY_PRODUCTION",
        "NEXT_PUBLIC_API_HITPAY_SANDBOX",
        "TRIGGER_VERSION"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.production"
      ]
