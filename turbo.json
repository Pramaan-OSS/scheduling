    "@scheduling/web#dx": {
      "cache": false,
      "dependsOn": [
        "@scheduling/prisma#dx"
      ]
    },
    "@scheduling/web#start": {
      "cache": false,
      "dependsOn": []
    },
    "@scheduling/atoms#build-npm": {
      "outputs": [
        "dist/**",
        "globals.min.css"
      ]
    },
    "@scheduling/ai#build": {
      "env": [
        "FRONTEND_URL",
        "BACKEND_URL",
        "APP_ID",
        "APP_URL",
        "SENDER_DOMAIN",
        "PARSE_KEY",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "DATABASE_URL"
      ]
