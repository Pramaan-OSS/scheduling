    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "db-deploy": {
      "cache": false,
      "inputs": [
        "./migrations/**/*.sql",
        "./prisma/migrations/**/*.sql"
      ]
    },
    "db-seed": {},
    "deploy": {
      "cache": false,
      "dependsOn": [
        "@scheduling/web#build"
      ]
    },
    "clean": {
      "cache": false,
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "@scheduling/web#dev": {
      "dependsOn": [
        "//#env-check:common",
        "//#env-check:app-store"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "//#env-check:common",
        "//#env-check:app-store"
      ],
      "cache": false
    },
    "dev:trigger": {
      "inputs": [
        "./.env"
      ],
      "env": [
        "TRIGGER_DEV_PROJECT_REF"
      ],
      "cache": false
    },
    "deploy:trigger:prod": {
      "inputs": [
        "./.env"
      ],
      "env": [
        "TRIGGER_DEV_PROJECT_REF",
        "TRIGGER_API_URL",
        "TRIGGER_SECRET_KEY",
        "TRIGGER_DEV_HOSTING_ACCESS_TOKEN",
        "TRIGGER_DEV_HOSTING_PROJECT_ID",
        "TRIGGER_DEV_HOSTING_TEAM_ID"
      ],
      "cache": false
    },
    "deploy:trigger:staging": {
      "inputs": [
        "./.env"
      ],
      "env": [
        "TRIGGER_DEV_PROJECT_REF",
        "TRIGGER_API_URL",
        "TRIGGER_SECRET_KEY",
        "TRIGGER_DEV_HOSTING_ACCESS_TOKEN",
        "TRIGGER_DEV_HOSTING_PROJECT_ID",
        "TRIGGER_DEV_HOSTING_TEAM_ID"
      ],
      "cache": false
    },
    "dx": {
      "dependsOn": [
        "//#env-check:common",
        "//#env-check:app-store"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "cache": false
    },
    "lint:report": {
      "outputs": [
        "lint-results"
      ]
    },
    "post-install": {
      "dependsOn": [],
      "outputs": [
        "../../node_modules/@prisma/client/**",
        "../../node_modules/@prisma/admin-client/**"
      ],
      "inputs": [
        "./schema.prisma",
        "./prisma/schema.prisma"
      ],
      "env": [
        "PRISMA_GENERATE_DATAPROXY"
      ]
    },
    "@scheduling/prisma#post-install": {
      "cache": false,
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "start": {
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "embed-tests": {
      "cache": false,
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "embed-tests-quick": {
      "cache": false,
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "type-check": {
      "cache": false,
      "dependsOn": [
        "@scheduling/trpc#build"
      ]
    },
    "type-check:ci": {
      "cache": false,
      "dependsOn": [
        "@scheduling/trpc#build"
      ]
    },
    "@scheduling/prisma#db-reset": {
      "cache": false,
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "@scheduling/app-store-cli#build": {
      "inputs": [
        "../../packages/app-store/**/package.json",
        "../../packages/app-store/**/config.json",
        "../../packages/app-store/**/api/**",
        "../../packages/app-store/**/components/**",
        "../../packages/app-store/**/lib/**",
        "../../packages/app-store/**/pages/**",
        "../../packages/app-store-cli/src/**"
      ],
      "outputs": [
        "../../packages/app-store/*.generated.ts",
        "../../packages/app-store/*.generated.tsx"
      ]
    },
    "@scheduling/embed-react#type-check": {
      "dependsOn": [
        "@scheduling/embed-core#build",
        "@scheduling/embed-snippet#build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "@scheduling/embed-core#build": {
      "cache": false,
      "outputs": [
        "../../../apps/web/public/embed/**"
      ],
      "env": [
        "EMBED_PUBLIC_HOSTING_URL",
        "EMBED_PUBLIC_WEBAPP_URL",
        "EMBED_PUBLIC_EMBED_FINGER_PRINT",
        "EMBED_PUBLIC_EMBED_VERSION"
      ]
    },
    "embed-tests-update-snapshots:ci": {
      "cache": false,
      "dependsOn": [
        "@scheduling/prisma#db-seed",
        "@scheduling/web#build",
        "^build",
        "^embed-tests-update-snapshots:ci"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "//#env-check:common": {
      "cache": false,
      "inputs": [
        "./.env.example",
        "./.env"
      ],
      "outputs": [
        "./.env"
      ]
    },
    "//#env-check:app-store": {
      "cache": false,
      "inputs": [
        "./.env.appStore.example",
        "./.env.appStore"
      ],
      "outputs": [
        "./.env.appStore"
      ]
    },
    "//#test": {
      "cache": false
    }
