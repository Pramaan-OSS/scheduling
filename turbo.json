        "NEXT_PUBLIC_HOSTING_BRANCH_URL",
        "NEXT_PUBLIC_METRICS_KEY",
        "NEXT_PUBLIC_METRICS_HOST",
        "LEGACY_PAYMENT_SUPPORT_TABLE",
        "MOTIFLAND_REST_ENDPOINT",
        "MOTIFLAND_DOCS_API_KEY",
        "MOTIFLAND_DOCS_PROJECT_ID"
