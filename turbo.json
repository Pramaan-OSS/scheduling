  "tasks": {
    "@scheduling/web#copy-app-store-static": {
      "inputs": [
        "../../packages/app-store/**/static/**/*"
      ],
      "outputLogs": "new-only",
      "outputs": [
        "public/app-store/**"
      ]
    },
    "@scheduling/prisma#build": {
      "cache": false,
      "dependsOn": [
        "post-install"
      ]
    },
    "@scheduling/prisma#db-migrate": {
      "cache": false,
      "dependsOn": [
        "@scheduling/prisma#db-up"
      ],
      "inputs": [
        "./schema.prisma",
        "./migrations/**/*.sql"
      ]
    },
    "@scheduling/prisma#db-seed": {
      "cache": false,
      "dependsOn": [
        "@scheduling/prisma#db-deploy"
      ]
    },
    "@scheduling/prisma#db-up": {
      "cache": false
    },
    "@scheduling/prisma#dx": {
      "cache": false,
      "dependsOn": [
        "@scheduling/prisma#db-up"
      ]
    },
    "@scheduling/app-store#build:types": {
      "outputs": [
        "types/**"
      ]
    },
    "@scheduling/trpc#build": {
      "dependsOn": [
        "@scheduling/prisma#post-install"
      ],
      "outputs": [
        "./types"
      ]
    },
    "@scheduling/web#build": {
      "dependsOn": [
        "^build",
        "copy-app-store-static"
      ],
      "outputs": [
        ".next/**"
      ],
      "env": [
        "NEXT_PUBLIC_AVAILABILITY_SCHEDULE_INTERVAL",
        "NEXT_PUBLIC_BOOKER_NUMBER_OF_DAYS_TO_LOAD",
        "NEXT_PUBLIC_CAL_AI_PHONE_NUMBER_MONTHLY_PRICE",
        "NEXT_PUBLIC_IS_E2E",
        "NEXT_PUBLIC_TRACING_DSN",
        "NEXT_PUBLIC_TRACING_DSN_CLIENT",
